# Base URL of the pos-api backend (Internship 1/POS Challenge/pos-api) used by the
# real login integration in src/lib/authApi.js. Not secret -- just a localhost address --
# so this file is safe to commit; if a real secret (an API key, etc.) ever needs to live
# here, put it in .env.local instead (already gitignored via the *.local rule).
VITE_API_URL=http://localhost:3000
